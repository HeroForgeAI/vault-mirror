{
  "name": "vault-mirror",
  "version": "0.1.1",
  "description": "Keeps one Obsidian vault and one local ruvector index in step, so an AI agent searches the index first. It only reads your notes.",
  "keywords": [
    "obsidian",
    "ruvector",
    "claude-code",
    "codex",
    "ai-agents",
    "markdown",
    "notes",
    "knowledge-base",
    "semantic-search",
    "vector-search",
    "local-first",
    "cli"
  ],
  "homepage": "https://github.com/HeroForgeAI/vault-mirror#readme",
  "bugs": {
    "url": "https://github.com/HeroForgeAI/vault-mirror/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeroForgeAI/vault-mirror.git"
  },
  "author": "Mak Allen (https://github.com/HeroForgeAI)",
  "type": "module",
  "bin": {
    "vault-mirror": "bin/vault-mirror.js"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "docs/BENCHMARKS.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.js\"",
    "acceptance": "node tests/acceptance/run.mjs --vault tests/fixtures/vault",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src bin tests"
  },
  "dependencies": {
    "ruvector": "0.3.3"
  },
  "overrides": {
    "@ruvector/core": "0.1.32"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "@types/node": "^24.0.0"
  }
}
